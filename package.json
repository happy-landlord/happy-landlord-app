{
  "name": "hlapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "husky",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "eas:configure": "npx eas build:configure",
    "build:preview:android": "npx eas build --platform android --profile preview",
    "build:preview:ios": "npx eas build --platform ios --profile preview",
    "build:production": "npx eas build --platform all --profile production",
    "build:production:ios": "npx eas build --platform ios --profile production",
    "build:production:android": "npx eas build --platform android --profile production",
    "submit:ios": "npx eas submit --platform ios --profile production --latest",
    "submit:android": "npx eas submit --platform android --profile production --latest",
    "release:ios": "npx eas build --platform ios --profile production --auto-submit",
    "release:android": "npx eas build --platform android --profile production --auto-submit",
    "release": "npx eas build --platform all --profile production --auto-submit",
    "publish:preview": "npx eas update --branch preview --environment preview --message \"Preview update\"",
    "publish:production": "npx eas update --branch production --environment production --message \"Production update\"",
    "publish:production:ios": "npx eas update --branch production --environment production --platform ios --message \"Production update (iOS)\"",
    "publish:production:android": "npx eas update --branch production --environment production --platform android --message \"Production update (Android)\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.9",
    "expo": "~57.0.22",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.18",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "private": true
}
